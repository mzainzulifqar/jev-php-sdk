{
    "name": "mzainzulifqar/jev-php-sdk",
    "description": "PHP SDK for TypeSafe AI System One models (Jev): send state and typed questions, get calibrated typed decisions.",
    "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "ai",
        "classification",
        "decisions"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/mzainzulifqar/jev-php-sdk",
    "authors": [
        {
            "name": "Zain Zulifqar",
            "homepage": "https://github.com/mzainzulifqar"
        }
    ],
    "support": {
        "issues": "https://github.com/mzainzulifqar/jev-php-sdk/issues",
        "source": "https://github.com/mzainzulifqar/jev-php-sdk"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 HTTP client works; Guzzle is the most common one.",
        "symfony/http-client": "An alternative PSR-18 client."
    },
    "autoload": {
        "psr-4": {
            "Zain\\Jev\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zain\\Jev\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
